; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Riot"
config/description="Open-world action driving game - Zade's story"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.1, 0.1, 0.12, 1)
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
WantedSystem="*res://scripts/autoload/wanted_system.gd"
WeaponSystem="*res://scripts/autoload/weapon_system.gd"
CharacterSelect="*res://scripts/autoload/character_select.gd"
MedicalSystem="*res://scripts/city/medical_system.gd"
AudioSettings="*res://scripts/autoload/audio_settings.gd"
StoreSystem="*res://scripts/autoload/store_system.gd"
AdSystem="*res://scripts/autoload/ad_system.gd"
ScreenshotCapture="*res://scripts/debug/screenshot_capture.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":87,"unicode":0,"echo":false,"script":null)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":83,"unicode":0,"echo":false,"script":null)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":65,"unicode":0,"echo":false,"script":null)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":68,"unicode":0,"echo":false,"script":null)]
}
handbrake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":32,"unicode":0,"echo":false,"script":null)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":69,"unicode":0,"echo":false,"script":null)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"key_label":0,"physical_keycode":67,"unicode":0,"echo":false,"script":null)]
}

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
